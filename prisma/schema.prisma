generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum KYCStatus {
  PENDING
  VERIFIED
}

enum SavingsStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum ContributionFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum GroupStatus {
  ACTIVE
  COMPLETED
}

enum TransactionType {
  DEPOSIT
  ALLOCATION
  PAYOUT
  WITHDRAWAL
  PERSONAL_WITHDRAWAL_FEE
  CIRCLE_PAYOUT_FEE
  OWNER_REVENUE_SETTLEMENT
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum RevenueType {
  PERSONAL_WITHDRAWAL_FEE
  CIRCLE_PAYOUT_FEE
}

enum SettlementStatus {
  COMPLETED
  FAILED
}

enum NotificationType {
  MISSED_CONTRIBUTION
  UPCOMING_WITHDRAWAL
  PAYOUT_COMPLETED
  CARRY_OVER_ALERT
  GROUP_INVITE
}

model User {
  id                   String          @id @default(uuid())
  name                 String
  email                String          @unique
  phone                String          @unique
  walletBalance        Decimal         @default(0)
  bvn                  String?
  kycStatus            KYCStatus       @default(PENDING)
  bankCode             String?
  bankAccountNumber    String?
  bankAccountName      String?
  paystackCustomerCode String?
  virtualAccountNumber String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  lockedSavings        LockedSavings?
  groupMemberships     GroupMember[]
  createdGroups        Group[]         @relation("GroupCreator")
  sentInvites          GroupInvite[]   @relation("InviteCreator")
  receivedInvites      GroupInvite[]   @relation("InviteRecipient")
  transactions         Transaction[]
  allocations          Allocation[]
  notifications        Notification[]
  revenues             PlatformRevenue[] @relation("RevenueSourceUser")
}

model LockedSavings {
  id                    String                @id @default(uuid())
  userId                String                @unique
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributionFrequency ContributionFrequency @default(DAILY)
  dailyAmount           Decimal
  totalTarget           Decimal
  lockDate              DateTime
  totalPaid             Decimal               @default(0)
  status                SavingsStatus         @default(ACTIVE)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  allocations           Allocation[]
}

model Group {
  id                 String        @id @default(uuid())
  name               String
  creatorId          String
  creator            User          @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  contributionAmount Decimal
  cycleDuration      Int
  minBuffer          Decimal
  payoutCursor       Int           @default(1)
  currentCycle       Int           @default(1)
  poolBalance        Decimal       @default(0)
  status             GroupStatus   @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  members            GroupMember[]
  invites            GroupInvite[]
  allocations        Allocation[]
  transactions       Transaction[]
  revenues           PlatformRevenue[] @relation("RevenueSourceGroup")
}

model GroupMember {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutOrder Int
  totalPaid   Decimal  @default(0)
  carryOver   Decimal  @default(0)
  paidFlag    Boolean  @default(false)
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([groupId, userId])
  @@unique([groupId, payoutOrder])
}

model GroupInvite {
  id                  String      @id @default(uuid())
  groupId             String
  group               Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creatorId           String
  creator             User        @relation("InviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  inviteeId           String
  invitee             User        @relation("InviteRecipient", fields: [inviteeId], references: [id], onDelete: Cascade)
  phoneLookup         String
  proposedPayoutOrder Int?
  status              InviteStatus @default(PENDING)
  createdAt           DateTime    @default(now())
  acknowledgedAt      DateTime?
  respondedAt         DateTime?

  @@index([groupId, status])
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  groupId     String?
  group       Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  type        TransactionType
  amount      Decimal
  referenceId String?         @unique
  metadata    Json?
  timestamp   DateTime        @default(now())
}

model Allocation {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lockedSavingsId String?
  lockedSavings   LockedSavings? @relation(fields: [lockedSavingsId], references: [id], onDelete: SetNull)
  groupId         String?
  group           Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  amount          Decimal
  timestamp       DateTime      @default(now())
}

model PlatformRevenue {
  id             String      @id @default(uuid())
  type           RevenueType
  amount         Decimal
  sourceUserId   String?
  sourceUser     User?       @relation("RevenueSourceUser", fields: [sourceUserId], references: [id], onDelete: SetNull)
  sourceGroupId  String?
  sourceGroup    Group?      @relation("RevenueSourceGroup", fields: [sourceGroupId], references: [id], onDelete: SetNull)
  transactionId  String?
  ownerAccount   String
  settlementId   String?
  settlement     RevenueSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  settledAt      DateTime?
  createdAt      DateTime    @default(now())

  @@index([settlementId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model OwnerPayoutSetting {
  id              String    @id @default(cuid())
  ownerName       String
  bankCode        String
  bankName        String?
  accountNumber   String
  accountName     String
  recipientCode   String?
  active          Boolean   @default(true)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model RevenueSettlement {
  id                 String           @id @default(uuid())
  status             SettlementStatus @default(COMPLETED)
  grossAmount        Decimal
  transferAmount     Decimal
  ownerAccountName   String
  ownerBankCode      String
  ownerAccountNumber String
  ownerRecipientCode String?
  transferReference  String?
  note               String?
  initiatedBy        String?
  createdAt          DateTime         @default(now())
  revenues           PlatformRevenue[]
}
